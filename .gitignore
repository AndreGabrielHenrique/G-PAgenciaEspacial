# Arquivo de configuração do Git para especificar arquivos/diretórios a serem ignorados
# Local: .gitignore (na raiz do projeto React/Vite)

# Logs de aplicação e ferramentas de desenvolvimento
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependências e builds
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?